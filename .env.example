# Copia este archivo como .env solo si ejecutas localmente con variables.
# En Render estas variables se configuran en el panel del servicio.
# NUNCA subas el archivo .env real (ya está en .gitignore).

# Puerto local de Flask. Render inyecta PORT automáticamente.
PORT=5000

# Orígenes permitidos por CORS, separados por comas.
# "*" = abierto (demo). En producción usa el dominio del frontend.
ALLOWED_ORIGINS=*

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
